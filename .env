# ==============================================================================
# BARA-Sense Frontend Environment Configuration (Local / Production)
# ==============================================================================

# Nama Brand & Deskripsi Aplikasi
VITE_APP_NAME=BARA-Sense
VITE_APP_TAGLINE=Building Automation & Realtime Analytics

# URL Backend REST API (kosong = otomatis mendeteksi window.location.origin / dev port 5173 ke localhost:3000)
VITE_API_BASE_URL=

# URL WebSocket Telemetri (kosong = otomatis mendeteksi host browser)
VITE_WS_URL=

# Pengaturan Default Energi & Analitik
VITE_DEFAULT_TARIFF=1300-2200VA

# Rentang Hari Default untuk History Konsumsi Listrik Harian
VITE_DEFAULT_HISTORY_DAYS=7

# Interval Polling Status Perangkat & Jadwal di Latar Belakang (ms)
VITE_POLL_INTERVAL_MS=10000
