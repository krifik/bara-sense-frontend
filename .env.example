# ==============================================================================
# BARA-Sense Frontend Environment Configuration
# ==============================================================================
# Variabel client-side di Vite wajib diawali dengan VITE_
# ==============================================================================

# Nama Brand & Deskripsi Aplikasi
VITE_APP_NAME=BARA-Sense
VITE_APP_TAGLINE=Building Automation & Realtime Analytics

# URL Backend REST API
# Kosongkan untuk deteksi otomatis (localhost:3000 pada mode dev port 5173, atau window.location.origin di production)
# Contoh custom host: http://localhost:3000 atau https://api.domain.com
VITE_API_BASE_URL=

# URL WebSocket Telemetri
# Kosongkan untuk deteksi otomatis (ws://localhost:3000/ws pada dev port 5173, atau ws(s)://{window.location.host}/ws)
# Contoh custom ws: ws://localhost:3000/ws atau wss://api.domain.com/ws
VITE_WS_URL=

# Pengaturan Default Energi & Analitik
# Pilihan tarif: 450VA, 900VA, 1300-2200VA, 3500-5500VA, 6600VA+
VITE_DEFAULT_TARIFF=1300-2200VA

# Rentang Hari Default untuk History Konsumsi Listrik Harian
VITE_DEFAULT_HISTORY_DAYS=7

# Interval Polling Status Perangkat & Jadwal di Latar Belakang (dalam milidetik)
VITE_POLL_INTERVAL_MS=10000
